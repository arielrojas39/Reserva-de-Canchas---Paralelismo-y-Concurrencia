DATABASE_URL=postgresql://postgres:postgres@localhost:5434/turnos

JWT_SECRET=cambiar-por-una-clave-propia
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Orígenes del frontend separados por comas. No uses "*" si allow_credentials=True.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Credenciales opcionales para crear el administrador inicial mediante seed.
# Dejar vacío (o comentar) para omitir la creación del admin.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Mercado Pago — Checkout Pro
# Crear una aplicación en https://www.mercadopago.com.ar/developers/panel/app
# Usar el Access Token de prueba en sandbox y el de producción al publicar.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_ENVIRONMENT=sandbox
# URL pública HTTPS del webhook. En local, usar ngrok/cloudflared.
# Ejemplo: https://abc123.ngrok-free.app/payments/webhook
MP_WEBHOOK_URL=
MP_STATEMENT_DESCRIPTOR=CANCHASPLAY
# URL pública del frontend para volver después del checkout.
FRONTEND_URL=http://localhost:3000
